<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 바깥 네온 후광 1단계 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E00E5FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 바깥 네온 후광 2단계 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#5500FFCC" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 본체 + 밝은 네온 튜브 테두리 -->
    <item
        android:bottom="3.5dp"
        android:left="3.5dp"
        android:right="3.5dp"
        android:top="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#F40D1B26" />
            <stroke
                android:width="2dp"
                android:color="#00FFCC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
